<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application
    android:name=".TFApp"
    android:allowBackup="true"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher"
    android:supportsRtl="true"
    android:theme="@style/Theme.TFApp"
  >
    <!--
      Compose Handles config changes

      https://www.reddit.com/r/androiddev/comments/qwu12a/activity_recreation_problem_is_solved_with/
      https://issuetracker.google.com/issues/457269058
      developer.android.com/reference/android/R.attr#configChanges
    -->
    <activity
      android:configChanges="allKnown"

      android:name=".main.MainActivity"
      android:excludeFromRecents="false"
      android:exported="true"
      android:launchMode="singleTask"
      android:noHistory="false"
      android:windowSoftInputMode="adjustPan"
    >
      <!-- Launcher Activity -->
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!-- "Configure" shortcut -->
      <intent-filter>
        <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>

      <!--
                  Shortcut
                  https://developer.android.com/develop/ui/views/launch/shortcuts/creating-shortcuts
                  -->
      <meta-data
        android:name="android.app.shortcuts"
        android:resource="@xml/shortcuts"
      />

      <!--
                  QS Tile Long Press Activity
                  https://developer.android.com/develop/ui/views/quicksettings-tiles
                   -->
      <intent-filter>
        <action
          android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES"
        />
      </intent-filter>
    </activity>

    <!--
              Must run as a ConnectedDevice ForegroundService

              https://github.com/pyamsoft/tetherfusenet/issues/250
            -->
    <service
      android:name=".foreground.ProxyForegroundService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="connectedDevice"
    />

    <!--
              https://developer.android.com/develop/ui/views/quicksettings-tiles#create-declare-tileservice
            -->
    <service
        android:name=".tile.StartProxyTileService"
        android:enabled="true"
        android:exported="true"
        android:icon="@drawable/ic_wifi_tethering_24"
        android:label="@string/start_hotspot"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <service
        android:name=".tile.StopProxyTileService"
        android:enabled="true"
        android:exported="true"
        android:icon="@drawable/ic_wifi_tethering_off_24"
        android:label="@string/stop_hotspot"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <service
      android:name=".tile.ToggleProxyTileService"
      android:enabled="true"
      android:exported="true"
      android:icon="@drawable/ic_wifi_tethering_24"
      android:label="@string/toggle_hotspot_shortcut"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
    >
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>

      <!-- Tile can be toggled -->
      <meta-data
        android:name="android.service.quicksettings.TOGGLEABLE_TILE"
        android:value="true"
      />
    </service>

    <!--
      Compose Handles config changes

      https://www.reddit.com/r/androiddev/comments/qwu12a/activity_recreation_problem_is_solved_with/
      https://issuetracker.google.com/issues/457269058
      developer.android.com/reference/android/R.attr#configChanges
    -->
    <activity
      android:configChanges="allKnown"

      android:name=".tile.ProxyTileActivity"
      android:clearTaskOnLaunch="true"
      android:excludeFromRecents="true"
      android:exported="true"
      android:launchMode="singleInstance"
      android:noHistory="true"
      android:theme="@style/Theme.TFApp.Tile"
      android:windowSoftInputMode="adjustPan"
    >
      <intent-filter>
        <action android:name="com.pyamsoft.tetherfi.action.START" />
        <action android:name="com.pyamsoft.tetherfi.action.STOP" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
  </application>
</manifest>
