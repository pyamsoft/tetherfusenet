BINDIR="$(realpath "$(dirname "$0")")"
ROOT="$(realpath "$(dirname "${BINDIR}")")"
unset BINDIR
readonly ROOT

main() {
  # Gradle expects to run from root
  cd "${ROOT}" || {
    printf -- 'Unable to cd into gradle root directory: %s\n' "${ROOT}"
    return 1
  }

  "${ROOT}"/gradlew --rerun-tasks --no-configuration-cache updateDaemonJvm --rerun --jvm-vendor ADOPTIUM "$@" || return 1
  return 0
}

main "$@"
exit "$?"
