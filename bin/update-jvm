set -e

BINDIR="$(realpath "$(dirname "$0")")"
ROOT="$(realpath "$(dirname "${BINDIR}")")"
readonly ROOT
unset BINDIR

main() {
  # Gradle expects to run from root
  cd "${ROOT}" || {
    printf -- 'Unable to cd into gradle root directory: %s\n' "${ROOT}"
    return 1
  }

  # Run gradle
  "${ROOT}/gradlew" updateDaemonJvm --jvm-version=25 --jvm-vendor=adoptium || return 1
  return 0
}

main "$@" || exit 1
exit 0
